# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/dbname

# Security Setup
JWT_SECRET_KEY=your-secret-key-here

# Flask Setup
FLASK_APP=run.py

# --- Optional (the defaults shown are used when a variable is missing) ---------------------------
# Comma-separated list of websites allowed to call the API (no spaces needed). "*" = everyone.
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Rate limits. Loosen them locally so automated tests do not get blocked.
# RATELIMIT_LOGIN=5 per minute
# RATELIMIT_REGISTER=10 per hour
# RATELIMIT_ENABLED=true

# How many reverse proxies sit in front of the app. Railway = 1 (so the real client IP is used for rate limits).
# TRUST_PROXY_HOPS=1

# Used ONLY by `python seed_mephub.py` (never commit real values)
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=